{
  "name": "scubaclient",
  "version": "1.1.3",
  "description": "Scuba API client",
  "main": "lib/index.js",
  "repository": "https://github.com/scality/scubaclient",
  "author": "Scality",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --strict",
    "lint": "prettier -c $(git ls-files '*.[jt]s') && eslint $(git ls-files '*.[jt]s')",
    "format": "prettier -w src tests && yarn lint --fix",
    "postinstall": "yarn build",
    "prepack": "yarn build",
    "prepare": "yarn build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests --verbose"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^30.2.0",
    "eslint": "^8.28.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-scality": "git+https://github.com/scality/Guidelines#8.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "27",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/signature-v4": "^5.3.7",
    "axios": "~1.18.1"
  },
  "engines": {
    "node": ">= 16"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
