{
  "name": "scubaclient",
  "version": "1.1.2",
  "description": "Scuba API client",
  "main": "lib/index.js",
  "repository": "https://github.com/scality/scubaclient",
  "author": "Scality",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --strict",
    "lint": "prettier -c $(git ls-files '*.[jt]s') && eslint $(git ls-files '*.[jt]s')",
    "format": "prettier -w src tests && yarn lint --fix",
    "postinstall": "yarn build",
    "prepack": "yarn build",
    "prepare": "yarn build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests --verbose"
  },
  "devDependencies": {
    "@babel/core": "^7.20.2",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.18.6",
    "@openapitools/openapi-generator-cli": "^2.5.2",
    "@types/jest": "^29.2.3",
    "@types/node": "^18.19.121",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "babel-jest": "^29.3.1",
    "eslint": "^8.28.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-scality": "git+https://github.com/scality/Guidelines#8.3.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "27",
    "jest": "^29.7.0",
    "prettier": "^2.8.7",
    "ts-jest": "^29.2.5",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/signature-v4": "^2.1.1",
    "axios": "^1.7.4"
  },
  "engines": {
    "node": ">= 16"
  },
  "peerDependencies": {
    "typescript": "^4.9.5"
  }
}
