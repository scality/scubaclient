{
  "name": "@scality/scubaclient",
  "version": "1.2.1",
  "description": "Scuba API client",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scality/scubaclient.git"
  },
  "bugs": {
    "url": "https://github.com/scality/scubaclient/issues"
  },
  "homepage": "https://github.com/scality/scubaclient#readme",
  "author": "Scality",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc --strict",
    "lint": "prettier -c $(git ls-files '*.[jt]s') && eslint $(git ls-files '*.[jt]s')",
    "format": "prettier -w src tests && yarn lint --fix",
    "prepack": "yarn build",
    "prepare": "yarn build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests --verbose"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@scality/eslint-config-scality": "scality/Guidelines#8.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/signature-v4": "^5.3.7",
    "axios": "~1.20.0"
  },
  "engines": {
    "node": ">= 22"
  }
}
